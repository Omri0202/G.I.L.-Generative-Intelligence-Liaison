# Copy this file to .env and fill in your own keys.
# .env is git-ignored and must never be committed.

# ── Required ─────────────────────────────────────────────────────────────────
# The brain. Free tier at https://console.groq.com
GROQ_API_KEY=
# Optional second key — requests rotate to it when the first hits its rate limit
GROQ_API_KEY_2=

# ── Vision fallbacks (optional, both have free tiers) ────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Set to 1 to allow paid vision models once the free tiers are exhausted.
# Left unset, G.I.L. will wait for the free quota to reset instead of spending.
GIL_ALLOW_PAID_VISION=

# ── Optional integrations ────────────────────────────────────────────────────
# Music control — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Web search — https://tavily.com
TAVILY_API_KEY=

# Repository operations from the coding agent
GITHUB_TOKEN=

# Higher-quality text-to-speech (edge-tts is used by default and needs no key)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Song identification from microphone audio
AUDD_API_KEY=
